# MongoDB Connection URLs

# Cloud MongoDB Atlas (Production)
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"

# Local MongoDB (Development)
# DATABASE_URL="mongodb://localhost:27017/<database>"

# Example with your Atlas cluster:
# DATABASE_URL="mongodb+srv://parikshitrajpurohit56_db_user:zpU3VPnXRDUNg0Yl@cluster0.y6oehhr.mongodb.net/ai-interview?retryWrites=true&w=majority"
